<!DOCTYPE html>
<html lang="pl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Panel Administracyjny — TD ROBLOX</title>

<style>
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: Arial, Helvetica, sans-serif;
}

body {
    background: #08131f;
    color: #fff;
}

.sidebar {
    position: fixed;
    left: 0;
    top: 0;
    width: 250px;
    height: 100vh;
    background: #0b1b2b;
    border-right: 1px solid #203548;
    padding: 22px 15px;
}

.logo {
    text-align: center;
    padding: 12px;
    margin-bottom: 25px;
}

.logo-icon {
    width: 55px;
    height: 55px;
    margin: auto;
    border-radius: 15px;
    background: #1689d7;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 25px;
}

.logo h2 {
    margin-top: 10px;
    font-size: 18px;
}

.logo p {
    color: #7f94a7;
    font-size: 12px;
    margin-top: 4px;
}

.menu-title {
    color: #62798c;
    font-size: 11px;
    font-weight: bold;
    margin: 20px 10px 8px;
}

.menu a {
    display: block;
    padding: 12px;
    margin-bottom: 5px;
    border-radius: 9px;
    color: #b8c8d5;
    text-decoration: none;
    font-size: 14px;
    transition: .2s;
}

.menu a:hover,
.menu a.active {
    background: #1689d7;
    color: white;
}

.main {
    margin-left: 250px;
    padding: 25px;
}

.topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30px;
}

.topbar h1 {
    font-size: 26px;
}

.status {
    padding: 9px 14px;
    border-radius: 20px;
    background: rgba(50,190,100,.12);
    color: #66df91;
    font-size: 13px;
}

.cards {
    display: grid;
    grid-template-columns: repeat(4, 1fr);

