<!DOCTYPE html>
<html lang="pl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Logowanie — TD ROBLOX</title>

<style>
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: Arial, Helvetica, sans-serif;
}

body {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #07111f, #0d2940);
    color: white;
}

.login-container {
    width: 420px;
    max-width: 92%;
    background: rgba(15, 30, 48, 0.97);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 22px;
    padding: 35px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.45);
}

.logo {
    width: 75px;
    height: 75px;
    margin: 0 auto 18px;
    border-radius: 18px;
    background: #1689d7;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 32px;
    box-shadow: 0 8px 25px rgba(22,137,215,0.35);
}

h1 {
    text-align: center;
    font-size: 25px;
    margin-bottom: 8px;
}

.subtitle {
    text-align: center;
    color: #9eafbf;
    font-size: 14px;
    margin-bottom: 30px;
}

label {
    display: block;
    margin-bottom: 8px;
    color: #dbe7f0;
    font-size: 14px;
    font-weight: bold;
}

.input-box {
    position: relative;
    margin-bottom: 20px;
}

input {
    width: 100%;
    padding: 14px 45px 14px 15px;
    border: 1px solid #31485c;
    border-radius: 12px;
    background: #0a1a2a;
    color: white;
    outline: none;
    font-size: 15px;
}

input:focus {
    border-color: #1689d7;
    box-shadow: 0 0 0 3px rgba(22,137,215,0.15);
}

.toggle-password {
    position: absolute;
    right: 13px;
    top: 50%;
    transform: translateY(-50%);
    cursor: pointer;
    color: #9eafbf;
    user-select: none;
}

button {
    width: 100%;
    padding: 15px;
    border: none;
    border-radius: 12px;
    background: #1689d7;
    color: white;
    font-size: 15px;
    font-weight: bold;
    cursor: pointer;
    transition: 0.2s;
}

button:hover {
    background: #0e75bb;
    transform: translateY(-1px);
}

.message {
    display: none;
    margin-top: 18px;
    padding: 12px;
    border-radius: 10px;
    text-align: center;
    font-size: 14px;
}

.error {
    background: rgba(220, 60, 60, 0.15);
    color: #ff8d8d;
    border: 1px solid rgba(220,60,60,0.25);
}

.footer {
    text-align: center;
    margin-top: 25px;
    color: #718596;
    font-size: 12px;
}

.badge {
    display: inline-block;
    margin-top: 8px;
    padding: 5px 10px;
    border-radius: 20px;
    background: rgba(22,137,215,0.12);
    color: #63b9f2;
}

@media (max-width: 500px) {
    .login-container {
        padding: 25px;
    }
}
</style>
</head>

<body>

<div class="login-container">

    <div class="logo">🚍</div>

    <h1>TD ROBLOX</h1>

    <div class="subtitle">
        Panel Administracyjny<br>
        Transportowe Dzielnice
    </div>

    <form id="loginForm">

        <label for="username">Nazwa użytkownika</label>

        <div class="input-box">
            <input
                type="text"
                id="username"
                placeholder="Wpisz nazwę użytkownika"
                autocomplete="username"
                required
            >
        </div>

        <label for="password">Hasło</label>

        <div class="input-box">

            <input
                type="password"
                id="password"
                placeholder="Wpisz hasło"
                autocomplete="current-password"
                required
            >

            <span
                class="toggle-password"
                onclick="togglePassword()"
                id="toggleIcon"
            >👁️</span>

        </div>

        <button type="submit">
            ZALOGUJ SIĘ
        </button>

    </form>

    <div id="message" class="message error">
        Nieprawidłowa nazwa użytkownika lub hasło.
    </div>

    <div class="footer">
        TD ROBLOX © 2026
        <div class="badge">
            🔐 Panel chroniony
        </div>
    </div>

</div>

<script>

// DEMONSTRACYJNE DANE LOGOWANIA
// Zmień je przed użyciem swojej wersji.
const ADMIN_USERNAME = "admin";
const ADMIN_PASSWORD = "TD1234";

function togglePassword() {

    const password = document.getElementById("password");
    const icon = document.getElementById("toggleIcon");

    if (password.type === "password") {
        password.type = "text";
        icon.textContent = "🙈";
    } else {
        password.type = "password";
        icon.textContent = "👁️";
    }
}

document.getElementById("loginForm").addEventListener("submit", function(event) {

    event.preventDefault();

    const username = document.getElementById("username").value.trim();
    const password = document.getElementById("password").value;

    const message = document.getElementById("message");

    if (
        username === ADMIN_USERNAME &&
        password === ADMIN_PASSWORD
    ) {

        sessionStorage.setItem("td_admin_logged", "true");

        window.location.href = "admin.html";

    } else {

        message.style.display = "block";

    }

});

</script>

</body>
</html>
