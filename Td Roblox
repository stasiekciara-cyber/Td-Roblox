<script>

if (sessionStorage.getItem("td_admin_logged") !== "true") {
    window.location.href = "logowanie.html";
}


function logout() {

    sessionStorage.removeItem("td_admin_logged");

    window.location.href = "logowanie.html";

}


function openModal() {

    document.getElementById("stopModal").style.display = "flex";

}


function closeModal() {

    document.getElementById("stopModal").style.display = "none";

}


function addStop() {

    const name =
        document.getElementById("stopName").value.trim();

    const type =
        document.getElementById("stopType").value;

    const location =
        document.getElementById("stopLocation").value.trim();

    const lines =
        document.getElementById("stopLines").value.trim() || "—";

    const status =
        document.getElementById("stopStatus").value;

    if (!name || !location) {

        alert(
            "Uzupełnij nazwę przystanku i lokalizację."
        );

        return;

    }

    const row = document.createElement("tr");

    row.dataset.type = type;
    row.dataset.status = status;

    let badgeClass = "active";

    if (type === "Na żądanie") {
        badgeClass = "request";
    }

    if (status === "Wyłączony") {
        badgeClass = "closed";
    }

    const badgeText =
        status === "Wyłączony"
        ? "● Wyłączony"
        : type === "Na żądanie"
        ? "● Na żądanie"
        : "● Aktywny";

    row.innerHTML = `
        <td><strong>${name}</strong></td>
        <td>${type}</td>
        <td>${location}</td>
        <td>${lines}</td>
        <td>
            <span class="badge ${badgeClass}">
                ${badgeText}
            </span>
        </td>
        <td class="actions">
            <button onclick="viewStop(this)">👁️</button>
            <button onclick="editStop(this)">✏️</button>
            <button onclick="removeStop(this)">🗑️</button>
        </td>
    `;

    document.getElementById("stopTable").appendChild(row);

    closeModal();

    document.getElementById("stopName").value = "";
    document.getElementById("stopLocation").value = "";
    document.getElementById("stopLines").value = "";

    updateStats();

}


function removeStop(button) {

    if (confirm("Czy na pewno usunąć ten przystanek?")) {

        button.closest("tr").remove();

        updateStats();

    }

}


function viewStop(button) {

    const row = button.closest("tr");

    alert(
        "PRZYSTANEK: " +
        row.children[0].innerText +
        "\nTYP: " +
        row.children[1].innerText +
        "\nLOKALIZACJA: " +
        row.children[2].innerText +
        "\nLINIE: " +
        row.children[3].innerText
    );

}


function editStop(button) {

    const row = button.closest("tr");

    alert(
        "Edycja przystanku: " +
        row.children[0].innerText +
        "\n\nPełny formularz edycji można rozbudować w kolejnym module."
    );

}


function filterStops() {

    const search =
        document.getElementById("search").value.toLowerCase();

    const type =
        document.getElementById("typeFilter").value;

    const status =
        document.getElementById("statusFilter").value;

    const rows =
        document.querySelectorAll("#stopTable tr");

    rows.forEach(row => {

        const text =
            row.innerText.toLowerCase();

        const typeMatch =
            !type || row.dataset.type === type;

        const statusMatch =
            !status || row.dataset.status === status;

        const searchMatch =
            text.includes(search);

        row.style.display =
            typeMatch && statusMatch && searchMatch
            ? ""
            : "none";

    });

}


function updateStats() {

    const rows =
        [...document.querySelectorAll("#stopTable tr")];

    let active = 0;
    let request = 0;
    let closed = 0;

    rows.forEach(row => {

        if (row.dataset.status === "Aktywny") {
            active++;
        }

        if (row.dataset.type === "Na żądanie") {
            request++;
        }

        if (row.dataset.status === "Wyłączony") {
            closed++;
        }

    });

    document.getElementById("total").innerText = rows.length;
    document.getElementById("active").innerText = active;
    document.getElementById("request").innerText = request;
    document.getElementById("closed").innerText = closed;

}

</script>

