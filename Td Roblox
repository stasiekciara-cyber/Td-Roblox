<script>

if (sessionStorage.getItem("td_admin_logged") !== "true") {
    window.location.href = "logowanie.html";
}


function logout() {

    sessionStorage.removeItem("td_admin_logged");

    window.location.href = "logowanie.html";

}


function openModal() {

    document.getElementById("lineModal").style.display = "flex";

}


function closeModal() {

    document.getElementById("lineModal").style.display = "none";

}


function addStop() {

    const box = document.getElementById("stopsBox");

    const row = document.createElement("div");

    row.className = "stop-row";

    row.innerHTML = `
        <input type="text" placeholder="Nazwa przystanku">
        <button onclick="removeStop(this)">×</button>
    `;

    box.appendChild(row);

}


function removeStop(button) {

    const rows =
        document.querySelectorAll(".stop-row");

    if (rows.length > 1) {
        button.parentElement.remove();
    }

}


function addLine() {

    const number =
        document.getElementById("lineNumber").value.trim();

    const type =
        document.getElementById("lineType").value;

    const direction =
        document.getElementById("lineDirection").value.trim();

    const status =
        document.getElementById("lineStatus").value;

    const stops =
        [...document.querySelectorAll("#stopsBox input")]
        .map(input => input.value.trim())
        .filter(Boolean);

    if (!number || !direction || stops.length === 0) {

        alert(
            "Uzupełnij numer linii, kierunek i przynajmniej jeden przystanek."
        );

        return;

    }

    let statusClass = "active";

    if (status === "Utrudnienia") {
        statusClass = "warning";
    }

    if (status === "Nieaktywna") {
        statusClass = "offline";
    }

    const row = document.createElement("tr");

    row.dataset.type = type;
    row.dataset.status = status;

    row.innerHTML = `
        <td><strong>${number}</strong></td>
        <td>${type}</td>
        <td>${direction}</td>
        <td>${stops.length}</td>
        <td>0</td>
        <td>
            <span class="badge ${statusClass}">
                ● ${status}
            </span>
        </td>
        <td class="actions">
            <button onclick="viewLine(this)">👁️</button>
            <button onclick="editLine(this)">✏️</button>
            <button onclick="removeLine(this)">🗑️</button>
        </td>
    `;

    document.getElementById("lineTable").appendChild(row);

    closeModal();

    resetForm();

    updateStats();

}


function resetForm() {

    document.getElementById("lineNumber").value = "";
    document.getElementById("lineDirection").value = "";

    document.getElementById("stopsBox").innerHTML = `
        <div class="stop-row">
            <input type="text" placeholder="Nazwa przystanku">
            <button onclick="removeStop(this)">×</button>
        </div>
    `;

}


function removeLine(button) {

    if (confirm("Czy na pewno usunąć tę linię?")) {

        button.closest("tr").remove();

        updateStats();

    }

}


function viewLine(button) {

    const row = button.closest("tr");

    alert(
        "LINIA: " + row.children[0].innerText +
        "\nTYP: " + row.children[1].innerText +
        "\nKIERUNEK: " + row.children[2].innerText +
        "\nPRZYSTANKI: " + row.children[3].innerText
    );

}


function editLine(button) {

    const row = button.closest("tr");

    alert(
        "Edycja linii " +
        row.children[0].innerText +
        "\n\nPełny formularz edycji możemy rozbudować w następnym module."
    );

}


function filterLines() {

    const search =
        document.getElementById("search").value.toLowerCase();

    const type =
        document.getElementById("typeFilter").value;

    const status =
        document.getElementById("statusFilter").value;

    const rows =
        document.querySelectorAll("#lineTable tr");

    rows.forEach(row => {

        const text =
            row.innerText.toLowerCase();

        const typeMatch =
            !type || row.dataset.type === type;

        const statusMatch =
            !status || row.dataset.status === status;

        const searchMatch =
            text.includes(search);

        row.style.display =
            typeMatch && statusMatch && searchMatch
            ? ""
            : "none";

    });

}


function updateStats() {

    const rows =
        [...document.querySelectorAll("#lineTable tr")];

    let active = 0;
    let warning = 0;
    let inactive = 0;

    rows.forEach(row => {

        if (row.dataset.status === "Aktywna") active++;
        if (row.dataset.status === "Utrudnienia") warning++;
        if (row.dataset.status === "Nieaktywna") inactive++;

    });

    document.getElementById("total").innerText = rows.length;
    document.getElementById("active").innerText = active;
    document.getElementById("warning").innerText = warning;
    document.getElementById("inactive").innerText = inactive;

}

</script>

