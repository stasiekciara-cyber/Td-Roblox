    updateStats();

    document.getElementById("vehicleNumber").value = "";
    document.getElementById("vehicleModel").value = "";
    document.getElementById("vehicleLine").value = "";

}


function removeVehicle(button) {

    if (confirm("Czy na pewno usunąć ten pojazd?")) {

        button.closest("tr").remove();

        updateStats();

    }

}


function editVehicle(button) {

    const row = button.closest("tr");

    const number = row.children[0].innerText;
    const model = row.children[1].innerText;

    alert(
        "Edycja pojazdu " +
        number +
        "\nModel: " +
        model +
        "\n\nPełny formularz edycji dodamy w kolejnej wersji."
    );

}


function filterVehicles() {

    const search =
        document.getElementById("search").value.toLowerCase();

    const type =
        document.getElementById("typeFilter").value;

    const status =
        document.getElementById("statusFilter").value;

    const rows =
        document.querySelectorAll("#vehicleTable tr");

    rows.forEach(row => {

        const text = row.innerText.toLowerCase();

        const typeMatch =
            !type || row.dataset.type === type;

        const statusMatch =
            !status || row.dataset.status === status;

        const searchMatch =
            text.includes(search);

        row.style.display =
            typeMatch && statusMatch && searchMatch
            ? ""
            : "none";

    });

}


function updateStats() {

    const rows =
        [...document.querySelectorAll("#vehicleTable tr")];

    let active = 0;
    let service = 0;
    let offline = 0;

    rows.forEach(row => {

        if (row.dataset.status === "W ruchu") active++;
        if (row.dataset.status === "W serwisie") service++;
        if (row.dataset.status === "Wyłączony") offline++;

    });

    document.getElementById("total").innerText = rows.length;
    document.getElementById("active").innerText = active;
    document.getElementById("service").innerText = service;
    document.getElementById("offline").innerText = offline;

}

</script>

</body>
</html>
