<script>

if (sessionStorage.getItem("td_admin_logged") !== "true") {
    window.location.href = "logowanie.html";
}


function logout() {

    sessionStorage.removeItem("td_admin_logged");

    window.location.href = "logowanie.html";

}


function openModal() {

    document.getElementById("messageModal").style.display = "flex";

}


function closeModal() {

    document.getElementById("messageModal").style.display = "none";

}


function updatePreview() {

    const title =
        document.getElementById("messageTitle").value.trim();

    const text =
        document.getElementById("messageText").value.trim();

    document.getElementById("previewTitle").innerText =
        title || "Podgląd komunikatu";

    document.getElementById("previewText").innerText =
        text || "Treść komunikatu pojawi się tutaj.";

}


function addMessage() {

    const title =
        document.getElementById("messageTitle").value.trim();

    const type =
        document.getElementById("messageType").value;

    const text =
        document.getElementById("messageText").value.trim();

    const status =
        document.getElementById("messageStatus").value;

    if (!title || !text) {

        alert(
            "Uzupełnij tytuł i treść komunikatu."
        );

        return;

    }

    let badgeClass = "info";

    if (type === "Utrudnienia") {
        badgeClass = "warning";
    }

    if (type === "Pilne") {
        badgeClass = "danger";
    }

    if (type === "Event") {
        badgeClass = "event";
    }

    const statusClass =
        status === "Opublikowany"
        ? "published"
        : "draft";

    const statusText =
        status === "Opublikowany"
        ? "● Opublikowany"
        : "● Roboczy";

    const today =
        new Date().toLocaleDateString("pl-PL");

    const row =
        document.createElement("tr");

    row.dataset.type = type;

    row.dataset.status = status;

    row.dataset.text =
        title + " " + text;

    row.innerHTML = `
        <td><strong>${title}</strong></td>
        <td>
            <span class="type-badge ${badgeClass}">
                ${type}
            </span>
        </td>
        <td>Administrator</td>
        <td>${today}</td>
        <td class="${statusClass}">
            ${statusText}
        </td>
        <td class="actions">
            <button onclick="viewMessage(this)">👁️</button>
            <button onclick="editMessage(this)">✏️</button>
            <button onclick="removeMessage(this)">🗑️</button>
        </td>
    `;

    document
        .getElementById("messageTable")
        .appendChild(row);

    closeModal();

    resetForm();

    updateStats();

}


function resetForm() {

    document.getElementById("messageTitle").value = "";

    document.getElementById("messageText").value = "";

    document.getElementById("messageType").value =
        "Informacja";

    document.getElementById("messageStatus").value =
        "Opublikowany";

    updatePreview();

}


function viewMessage(button) {

    const row =
        button.closest("tr");

    alert(
        "TYTUŁ:\n" +
        row.children[0].innerText +
        "\n\nTYP: " +
        row.children[1].innerText +
        "\nAUTOR: " +
        row.children[2].innerText +
        "\nDATA: " +
        row.children[3].innerText
    );

}


function editMessage(button) {

    const row =
        button.closest("tr");

    alert(
        "Edycja komunikatu:\n\n" +
        row.children[0].innerText +
        "\n\nFormularz edycji możemy rozbudować w kolejnej wersji."
    );

}


function removeMessage(button) {

    if (
        confirm(
            "Czy na pewno usunąć ten komunikat?"
        )
    ) {

        button.closest("tr").remove();

        updateStats();

    }

}


function filterMessages() {

    const search =
        document
            .getElementById("search")
            .value
            .toLowerCase();

    const type =
        document.getElementById("typeFilter").value;

    const status =
        document.getElementById("statusFilter").value;

    const rows =
        document.querySelectorAll("#messageTable tr");

    rows.forEach(row => {

        const text =
            row.innerText.toLowerCase();

        const typeMatch =
            !type ||
            row.dataset.type === type;

        const statusMatch =
            !status ||
            row.dataset.status === status;

        const searchMatch =
            text.includes(search);

        row.style.display =
            typeMatch &&
            statusMatch &&
            searchMatch
            ? ""
            : "none";

    });

}


function updateStats() {

    const rows =
        [...document.querySelectorAll("#messageTable tr")];

    let published = 0;
    let draft = 0;

    rows.forEach(row => {

        if (
            row.dataset.status ===
            "Opublikowany"
        ) {
            published++;
        }

        if (
            row.dataset.status ===
            "Roboczy"
        ) {
            draft++;
        }

    });

    document.getElementById("total").innerText =
        rows.length;

    document.getElementById("published").innerText =
        published;

    document.getElementById("draft").innerText =
        draft;

}

</script>

