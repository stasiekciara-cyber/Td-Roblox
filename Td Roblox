<script>

if (sessionStorage.getItem("td_admin_logged") !== "true") {
    window.location.href = "logowanie.html";
}


function logout() {

    sessionStorage.removeItem("td_admin_logged");

    window.location.href = "logowanie.html";

}


function openModal() {

    document.getElementById("eventModal").style.display = "flex";

}


function closeModal() {

    document.getElementById("eventModal").style.display = "none";

}


function formatDate(date) {

    if (!date) return "—";

    const parts = date.split("-");

    return parts[2] + "." + parts[1] + "." + parts[0];

}


function addEvent() {

    const name =
        document.getElementById("eventName").value.trim();

    const icon =
        document.getElementById("eventIcon").value.trim() || "📅";

    const start =
        document.getElementById("startDate").value;

    const end =
        document.getElementById("endDate").value;

    const status =
        document.getElementById("eventStatus").value;

    if (!name || !start || !end) {

        alert(
            "Uzupełnij nazwę oraz obie daty eventu."
        );

        return;

    }

    const row =
        document.createElement("tr");

    row.dataset.status = status;

    let statusClass = "planned-status";

    if (status === "Aktywny") {
        statusClass = "active-status";
    }

    if (status === "Zakończony") {
        statusClass = "finished-status";
    }

    if (status === "Roboczy") {
        statusClass = "draft-status";
    }

    row.innerHTML = `

        <td>
            <div class="event-icon">
                ${icon}
            </div>
        </td>

        <td>
            <strong>${name}</strong>
        </td>

        <td>
            ${formatDate(start)}
            –
            ${formatDate(end)}
        </td>

        <td>
            Administrator
        </td>

        <td>
            <span class="status ${statusClass}">
                ● ${status}
            </span>
        </td>

        <td class="actions">

            <button onclick="viewEvent(this)">
                👁️
            </button>

            <button onclick="editEvent(this)">
                ✏️
            </button>

            <button onclick="deleteEvent(this)">
                🗑️
            </button>

        </td>

    `;

    document
        .getElementById("eventTable")
        .appendChild(row);

    closeModal();

    resetForm();

    updateStats();

}


function resetForm() {

    document.getElementById("eventName").value = "";

    document.getElementById("eventIcon").value = "";

    document.getElementById("startDate").value = "";

    document.getElementById("endDate").value = "";

    document.getElementById("eventStatus").value =
        "Zaplanowany";

    document.getElementById("eventDescription").value = "";

}


function viewEvent(button) {

    const row =
        button.closest("tr");

    alert(
        "EVENT:\n\n" +
        row.children[1].innerText +
        "\n\nTERMIN: " +
        row.children[2].innerText +
        "\nORGANIZATOR: " +
        row.children[3].innerText +
        "\nSTATUS: " +
        row.children[4].innerText
    );

}


function editEvent(button) {

    const row =
        button.closest("tr");

    alert(
        "Edycja eventu:\n\n" +
        row.children[1].innerText +
        "\n\nPełny edytor eventu możemy rozbudować w kolejnej wersji."
    );

}


function deleteEvent(button) {

    if (
        confirm(
            "Czy na pewno usunąć ten event?"
        )
    ) {

        button.closest("tr").remove();

        updateStats();

    }

}


function filterEvents() {

    const search =
        document
            .getElementById("search")
            .value
            .toLowerCase();

    const status =
        document
            .getElementById("statusFilter")
            .value;

    const rows =
        document.querySelectorAll("#eventTable tr");

    rows.forEach(row => {

        const text =
            row.innerText.toLowerCase();

        const statusMatch =
            !status ||
            row.dataset.status === status;

        const searchMatch =
            text.includes(search);

        row.style.display =
            statusMatch &&
            searchMatch
            ? ""
            : "none";

    });

}


function updateStats() {

    const rows =
        [...document.querySelectorAll("#eventTable tr")];

    let active = 0;
    let planned = 0;
    let finished = 0;

    rows.forEach(row => {

        if (row.dataset.status === "Aktywny") {
            active++;
        }

        if (row.dataset.status === "Zaplanowany") {
            planned++;
        }

        if (row.dataset.status === "Zakończony") {
            finished++;
        }

    });

    document.getElementById("total").innerText =
        rows.length;

    document.getElementById("active").innerText =
        active;

    document.getElementById("planned").innerText =
        planned;

    document.getElementById("finished").innerText =
        finished;

}

</script>

</body>
