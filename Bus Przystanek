    color: white;
}

.sidebar {
    position: fixed;
    width: 250px;
    height: 100vh;
    background: #0b1b2b;
    border-right: 1px solid #203548;
    padding: 22px 15px;
}

.logo {
    text-align: center;
    margin-bottom: 25px;
}

.logo-icon {
    width: 55px;
    height: 55px;
    margin: auto;
    border-radius: 15px;
    background: #1689d7;
    display: flex;
    align-items: center;
    justify-content: center;
