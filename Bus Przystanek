}

.menu-title {
    color: #62798c;
    font-size: 11px;
    font-weight: bold;
    margin: 20px 10px 8px;
}

.menu a {
    display: block;
    padding: 12px;
    margin-bottom: 5px;
    border-radius: 9px;
    color: #b8c8d5;
    text-decoration: none;
    font-size: 14px;
}

.menu a:hover,
.menu a.active {
    background: #1689d7;
    color: white;
}

.logout {
    position: absolute;
    bottom: 20px;
    left: 15px;
    right: 15px;
    padding: 12px;
    border: none;
    border-radius: 9px;
    background: #182b3c;
    color: #ff8888;
    cursor: pointer;
}

.main {
    margin-left: 250px;
    padding: 28px;
}

.header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 25px;
}

.header h1 {
    font-size: 27px;
}

.header p {
    color: #7890a2;
    margin-top: 5px;
}

.add-btn {
    border: none;
    padding: 13px 18px;
    border-radius: 10px;
    background: #1689d7;
    color: white;
    font-weight: bold;
    cursor: pointer;
}

.stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 15px;
    margin-bottom: 22px;
}

.stat {
    background: #0d2031;
    border: 1px solid #1d3549;
    border-radius: 14px;
    padding: 18px;
}

.stat-icon {
    font-size: 24px;
}

.stat-number {
    font-size: 25px;
    font-weight: bold;
    margin-top: 8px;
}

.stat-name {
    color: #8196a8;
    font-size: 13px;
    margin-top: 4px;
}

.panel {
    background: #0d2031;
    border: 1px solid #1d3549;
    border-radius: 15px;
    padding: 20px;
}

.filters {
    display: flex;
    gap: 10px;
    margin-bottom: 20px;
}

input,
select {
    padding: 12px;
    border-radius: 9px;
    border: 1px solid #30485c;
    background: #091a29;
    color: white;
    outline: none;
}

.search {
    flex: 1;
}

table {
    width: 100%;
    border-collapse: collapse;
}

th,
td {
    text-align: left;
    padding: 14px 10px;
    border-bottom: 1px solid #1c3346;
    font-size: 13px;
}

